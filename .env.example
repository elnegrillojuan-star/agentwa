# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key, never expose to the browser. Used for privileged backend operations
# and by the YCloud webhook / agent runtime, which have no user session.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter model used by the agent runtime when a workspace has none configured.
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# YCloud API key, webhook secret, WhatsApp number, and each workspace's OpenRouter
# key are NOT env vars — they live per-workspace in the `workspaces` table (see
# supabase/migrations/0001_init.sql), since this is a multi-tenant product and
# every workspace connects its own WhatsApp number and model provider.
